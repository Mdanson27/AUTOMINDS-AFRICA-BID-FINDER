rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && currentUser().data.role == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'viewer'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    match /bids/{bidId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /sources/{sourceId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /changes/{changeId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /sources/{sourceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /crawlRuns/{runId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /organizations/{organizationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /savedBids/{savedId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && onlyKeys(['ownerUid', 'bidId', 'savedAt', 'stage', 'notes', 'updatedAt']);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.bidId == resource.data.bidId;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /savedSearches/{searchId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }

    match /userPreferences/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /companyProfiles/{uid} {
      allow read, create, update, delete: if isOwner(uid) || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAdmin();
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
